# Application Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://vaibhavsaini@localhost:5432/latch_dev
TEST_DATABASE_URL=postgresql://vaibhavsaini@localhost:5432/latch_test
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Security & Session Settings
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
SESSION_SECRET=dev-session-secret-must-be-at-least-32-chars-long-for-security
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

