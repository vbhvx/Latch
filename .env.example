# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (use a role that is NOSUPERUSER NOBYPASSRLS in production so row-level security is enforced)
DATABASE_URL=postgresql://latch_admin:latch_admin_password@localhost:5432/latch_dev
TEST_DATABASE_URL=postgresql://latch_admin:latch_admin_password@localhost:5432/latch_test
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Security & sessions
# Generate with: openssl rand -hex 32   (placeholder values are rejected when NODE_ENV=production)
SESSION_SECRET=dev-session-secret-must-be-at-least-32-chars-long-for-security
SESSION_TTL_HOURS=24
SESSION_CLEANUP_INTERVAL_MINUTES=60
# Production requires COOKIE_SECURE=true and an explicit (non-wildcard) CORS_ORIGIN
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# Reverse proxy: number of trusted hops for X-Forwarded-For (0 = none). Set to 1 behind a single LB/ingress,
# otherwise rate limiting keys on the proxy's IP instead of the client's.
TRUST_PROXY_HOPS=0
BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000

# Surface area
ENABLE_DOCS=true
ENABLE_METRICS=true
# If set, GET /metrics requires "Authorization: Bearer <token>" (min 16 chars)
# METRICS_TOKEN=

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
