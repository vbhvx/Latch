{
  "name": "latch-secure-backend",
  "version": "1.0.0",
  "description": "Security-First Backend Engineering Platform directly on PostgreSQL",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx db/migrate.ts up",
    "migrate:down": "tsx db/migrate.ts down",
    "migrate:status": "tsx db/migrate.ts status",
    "seed": "tsx db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbhvx/Latch.git"
  },
  "keywords": [
    "security",
    "postgresql",
    "fastify",
    "typescript",
    "rbac",
    "row-level-security",
    "transactions",
    "parameterized-sql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "argon2": "^0.45.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^3.2.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "yaml": "^2.7.0"
  }
}
