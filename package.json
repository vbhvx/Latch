{
  "name": "latch-secure-backend",
  "version": "1.0.0",
  "description": "Security-first multi-tenant task API: Fastify, PostgreSQL row-level security, Argon2id sessions, RBAC",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx db/migrate.ts up",
    "migrate:down": "tsx db/migrate.ts down",
    "migrate:status": "tsx db/migrate.ts status",
    "seed": "tsx db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "docker:up": "docker compose up --build",
    "migrate:prod": "node dist/db/migrate.js up"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbhvx/Latch.git"
  },
  "keywords": [
    "security",
    "postgresql",
    "fastify",
    "typescript",
    "rbac",
    "row-level-security",
    "transactions",
    "parameterized-sql"
  ],
  "author": "vbhvx",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.3",
    "argon2": "^0.45.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.0.7",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
